---
import { type Lang, pairs, tr } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const kinds = ["request", "response", "push", "lost", "self"] as const;
const items = pairs(lang, "legend");
---

<aside class="legend" aria-labelledby="legend-title">
  <h3 id="legend-title">{tr(lang, "legendTitle")}</h3>
  <ul>
    {
      kinds.map((k, i) => (
        <li class={`legend-item legend-item--${k}`}>
          <svg viewBox="0 0 48 12" aria-hidden="true">
            {k === "self" ? (
              <path class="arrow" d="M8,2 h18 v8 h-16" />
            ) : (
              <line class="arrow" x1="2" x2={k === "lost" ? 30 : 44} y1="6" y2="6" />
            )}
            {k === "lost" ? (
              <path class="lost-x" d="M27,1 l8,8 M35,1 l-8,8" />
            ) : (
              <path class="head" d={k === "self" ? "M10,7 L4,10 L10,13 z" : "M38,2 L46,6 L38,10 z"} />
            )}
          </svg>
          <b>{items[i]?.[0]}</b>
          <span>{items[i]?.[1]}</span>
        </li>
      ))
    }
  </ul>
  <p class="legend-keys">{tr(lang, "keys")}</p>
</aside>
