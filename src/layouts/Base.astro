---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { LANGS, type Lang, tr } from "../i18n/ui";
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/opsz-italic.css";
import "@fontsource-variable/schibsted-grotesk/wght.css";
import "@fontsource-variable/martian-mono/wdth.css";
import "../styles/global.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const title = tr(lang, "siteTitle");
const description = tr(lang, "siteDescription");
const canonical = getAbsoluteLocaleUrl(lang, "");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, "")} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("en", "")} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
  </head>
  <body>
    <a class="skip" href="#main">{tr(lang, "skip")}</a>
    <slot />
  </body>
</html>
